# MYBOT_ADMIN_TOKEN=change-me  # otherwise a random one is printed at startup
# ANTHROPIC_API_KEY=           # optional: LLM news extraction
# MYBOT_MODE=live              # also requires MYBOT_LIVE_CONFIRM=I_UNDERSTAND_THE_RISKS
